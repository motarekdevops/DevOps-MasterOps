[Unit]
Description=MasterOps .NET API for {{ project_name }}
After=network.target

[Service]
WorkingDirectory={{ project_path }}/backend/{{ project_name }}_api
ExecStart=/usr/bin/dotnet {{ project_path }}/backend/{{ project_name }}_api/{{ project_name }}_api.dll
Restart=always
# Restart service after 10 seconds if it crashes
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-{{ project_name }}
User={{ ansible_user | default(ansible_env.USER) }}
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target
