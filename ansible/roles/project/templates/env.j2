# MasterOps Generated Environment File
APP_NAME={{ project_name }}
APP_ENV=production
APP_KEY=base64:{{ lookup('ansible.builtin.password', '/dev/null length=32') }}
APP_DEBUG=false
APP_URL=http://{{ domain }}

# Database Configuration
DB_CONNECTION={{ 'pgsql' if db_type == 'postgres' else db_type }}
DB_HOST=127.0.0.1
DB_PORT={{ '5432' if db_type == 'postgres' else '3306' }}
DB_DATABASE={{ project_name }}_db
DB_USERNAME=masterops_user
DB_PASSWORD={{ db_password }}
